# Copie para .env.local e preencha. O .env.local nunca é versionado.
#
# Estas chaves são lidas APENAS no servidor (funções de api/ e o middleware de
# desenvolvimento). Não use o prefixo VITE_ nelas: o Vite embutiria a chave no
# bundle do browser e ela ficaria pública.
#
# Na Vercel, cadastre as mesmas variáveis em Project Settings > Environment Variables.

# https://www.pexels.com/api/  — gratuita, 200 requisições/hora
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  — gratuita. Fallback do Pexels na busca de
# vídeos. NÃO serve para trilha: o endpoint /api/audio/ responde 403 mesmo com
# chave válida, e a trilha vem da pasta public/music/.
PIXABAY_API_KEY=

# Opcional: caminho do binário do FFmpeg quando ele não está no PATH.
# Só afeta o render local; o site publicado usa o ffmpeg-static.
# FFMPEG_PATH=
